# Docker Compose configuration for local development.
# Copy this file to .env and adjust values as needed. Never commit the
# real .env file.

# Port where the reverse proxy exposes the app (frontend + API) on the host.
APP_PORT=8080

# MySQL — shared by the mysql service and injected into the backend
# container, overriding backend/.env so both always match.
MYSQL_DATABASE=barber_booking
MYSQL_USER=barber_booking
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret
# Host port mapped to MySQL, useful for connecting a local client. Not used
# by the containers themselves, which talk to each other over the internal
# "mysql:3306" address.
MYSQL_HOST_PORT=3307

# Mailpit (local SMTP sink), web UI port on the host.
MAILPIT_WEB_PORT=8025
