# Barber Booking — production environment (example, no secrets).
# Copy to .env.production on the server, replace every <...> value and keep
# the real file out of Git (it is ignored). The same file is the backend's
# environment (env_file) and the source of docker-compose.prod.yml's
# ${...} values:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# The backend refuses to start while any <...> placeholder is left.
# See docs/desenvolvimento.md, "Produção com Docker".

# --- Images / Compose -------------------------------------------------------
COMPOSE_PROJECT_NAME=barber-booking-prod
# Tag the images with the release (e.g. the short Git commit) so a previous
# release can be started again (rollback).
IMAGE_TAG=<release-tag>
# Where `web` is published on the host. Keep 127.0.0.1 when the TLS proxy
# runs on the same host.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Scheme the visitors use. https: the TLS proxy in front terminates HTTPS.
PUBLIC_SCHEME=https
# Network the TLS proxy connects from (its X-Forwarded-For is trusted).
REAL_IP_FROM=172.16.0.0/12

# --- Application --------------------------------------------------------------
APP_NAME="Barber Booking"
APP_ENV=production
# Never true in production: true shows stack traces and configuration. The
# image refuses to start with anything other than false.
APP_DEBUG=false
# Generate once and keep it (changing it logs every admin out and
# invalidates the cancellation links already e-mailed):
#   docker run --rm --entrypoint php barber-booking-backend:<tag> artisan key:generate --show
APP_KEY=<base64:...>
# Public URL (https), used in the cancellation links sent by e-mail.
APP_URL=https://<your-domain>
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Plain-HTTP mode for a local validation of this stack only (no
# certificate). Never true on a real server.
ALLOW_INSECURE_HTTP=false

# Logs go to the container output (docker compose logs); no log files.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (the `mysql` service of docker-compose.prod.yml) -----------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=barber_booking
DB_USERNAME=barber_booking
DB_PASSWORD=<long-random-password>
MYSQL_ROOT_PASSWORD=<another-long-random-password>

# --- Session and cookies ------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS only: the browser never sends the session or XSRF cookie over HTTP.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host (and port, if not 443) of APP_URL: Sanctum only grants cookie
# sessions to requests coming from it.
SANCTUM_STATEFUL_DOMAINS=<your-domain>

# --- Rate limits of the admin login -------------------------------------------
ADMIN_LOGIN_THROTTLE_PER_EMAIL=5
ADMIN_LOGIN_THROTTLE_PER_IP=20

# --- Cache and locks (the scheduler's onOneServer/withoutOverlapping) ----------
CACHE_STORE=database
# No queue worker: nothing is queued (the confirmation e-mail is sent after
# the commit and retried by the scheduler).
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- E-mail (any SMTP server; the credentials live only in this file) ---------
MAIL_MAILER=smtp
# smtps for implicit TLS (usually port 465); null lets port 587 use STARTTLS.
MAIL_SCHEME=null
MAIL_HOST=<smtp.provider.example>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
# Seconds before giving up on the SMTP server (the booking is never undone).
MAIL_TIMEOUT=5
MAIL_FROM_ADDRESS=<no-reply@your-domain>
MAIL_FROM_NAME="Barber Booking"
