APP_NAME="Barber Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In docker-compose.yml these DB_* values are overridden by the root .env
# file so the backend always matches the mysql service credentials.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=barber_booking
DB_USERNAME=barber_booking
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Frontend/API share this origin through the docker-compose proxy — Sanctum
# only issues stateful (cookie) auth to requests whose Origin/Referer match
# one of these hosts.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Admin login throttling: N attempts/minute per IP+e-mail, and a looser
# per-IP ceiling. Both count failed attempts. Lowered in tests so the limits
# can actually be exercised without waiting a real minute.
ADMIN_LOGIN_THROTTLE_PER_EMAIL=5
ADMIN_LOGIN_THROTTLE_PER_IP=20

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@barberbooking.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
